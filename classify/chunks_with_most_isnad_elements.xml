|<tafsir_chunk>
<asbab_al_nuzul>فأنزل الله هذه الآية :</asbab_al_nuzul>
<quran_verse>( ولقد نعلم أنهم يقولون إنما يعلمه بشر لسان الذي يلحدون إليه أعجمي وهذا لسان عربي مبين )</quran_verse>
      .
