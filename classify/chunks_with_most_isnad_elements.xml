|<tafsir_chunk>
<opinions_of_scholars>
        وقال : <cross_references><quran_verse>( سأل سائل بعذاب واقع )</quran_verse> <source/>[ المعارج : 1 ]</cross_references>
</opinions_of_scholars>
</tafsir_chunk>
|<tafsir_chunk>
<opinions_of_scholars>
        وقال : <cross_references><quran_verse>( يستعجل بها الذين لا يؤمنون بها والذين آمنوا مشفقون منها ويعلمون أنها الحق )</quran_verse> <source/>[ الشورى : 18 ]</cross_references>
</opinions_of_scholars>
</tafsir_chunk>
|<tafsir_chunk>
<opinions_of_scholars>
<quran_verse>( وقالوا ربنا عجل لنا قطنا قبل يوم الحساب )</quran_verse> أي : <linguistic_analysis>حسابنا وعقابنا</linguistic_analysis> ،
      </opinions_of_scholars>
</tafsir_chunk>
|<tafsir_chunk>
<opinions_of_scholars>
        كما قال مخبرا عنهم : <cross_references><quran_verse>( وإذ قالوا اللهم إن كان هذا هو الحق من عندك فأمطر علينا حجارة من السماء أو ائتنا بعذاب أليم )</quran_verse> <source/>[ الأنفال : 32 ]</cross_references>
</opinions_of_scholars>
</tafsir_chunk>
|<tafsir_chunk>
<opinions_of_scholars>
