4305|<tafsir_chunk>
      وقوله : ( <quran_verse>أو أكننتم في أنفسكم</quran_verse> ) أي : <linguistic_analysis>أضمرتم في أنفسكم خطبتهن</linguistic_analysis> وهذا كقوله تعالى : ( <quran_verse>وربك يعلم ما تكن صدورهم وما يعلنون</quran_verse> ) [ القصص : 69 ] وكقوله : ( <quran_verse>وأنا أعلم بما أخفيتم وما أعلنتم</quran_verse> ) [ الممتحنة : 1 ] ولهذا قال : ( <quran_verse>علم الله أنكم ستذكرونهن</quran_verse> ) أي : <theological_points>في أنفسكم ، فرفع الحرج عنكم في ذلك</theological_points>
