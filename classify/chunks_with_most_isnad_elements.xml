      </hadith_support>
</tafsir_chunk>
|<tafsir_chunk>
<hadith_support>
<asbab_al_nuzul>لما نزلت هذه الآية : <quran_verse>( وإن ربك لذو مغفرة للناس على ظلمهم وإن ربك لشديد العقاب )</quran_verse></asbab_al_nuzul>
</hadith_support>
