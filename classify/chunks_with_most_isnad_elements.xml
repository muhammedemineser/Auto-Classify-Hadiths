    </tafsir_chunk>
|<tafsir_chunk>
      وقال تعالى : <cross_references><quran_verse>( وإذا تتلى عليه آياتنا ولى مستكبرا كأن لم يسمعها كأن في أذنيه وقرا فبشره بعذاب أليم )</quran_verse> [ لقمان : 7 ]</cross_references> .
