<cross_references><opinions_of_scholars>كما قال : <quran_verse>( وقرآنا فرقناه لتقرأه على الناس على مكث ونزلناه تنزيلا )</quran_verse> [ الإسراء : 106 ] ;</opinions_of_scholars></cross_references>
