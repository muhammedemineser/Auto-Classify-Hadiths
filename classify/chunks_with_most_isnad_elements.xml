386|<tafsir_chunk>
      وقال <source/>خصيف ، عن <isnad>مجاهد</isnad> ، أنه قال : <opinions_of_scholars>فواتح السور كلها " ق " و " ص " و " حم " و " طسم " و " الر " وغير ذلك هجاء موضوع</opinions_of_scholars> .
