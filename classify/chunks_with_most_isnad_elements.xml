      </tafsir_chunk>
1204|<tafsir_chunk>
<opinions_of_scholars>وزعم بعضهم أنه تأكيد وتكرير ، <linguistic_analysis>كما تقول : قم قم</linguistic_analysis> ،</opinions_of_scholars>
</tafsir_chunk>
1205|<tafsir_chunk>
<opinions_of_scholars>وقال آخرون : بل الإهباط الأول من الجنة إلى السماء الدنيا ، والثاني من سماء الدنيا إلى الأرض ،</opinions_of_scholars>
</tafsir_chunk>
1206|<tafsir_chunk>
<conclusion>والصحيح الأول</conclusion> ، والله تعالى أعلم بأسرار كتابه ] .
      </tafsir_chunk>
1207|<tafsir_chunk>
<command_and_prohibition>يقول تعالى آمرا بني إسرائيل بالدخول في الإسلام ، ومتابعة محمد عليه من الله أفضل الصلاة والسلام ،</command_and_prohibition> <rhetorical_devices>ومهيجا لهم بذكر أبيهم إسرائيل ، وهو نبي الله يعقوب ، عليه السلام ،</rhetorical_devices> <linguistic_analysis>وتقديره : يا بني العبد الصالح المطيع لله كونوا مثل أبيكم في متابعة الحق ، كما تقول : يا ابن الكريم ، افعل كذا . يا ابن الشجاع ، بارز الأبطال ، يا ابن العالم ، اطلب العلم ، ونحو ذلك .</linguistic_analysis>
</tafsir_chunk>
1208|<tafsir_chunk>
      ومن ذلك أيضا قوله تعالى : <cross_references><quran_verse>( ذرية من حملنا مع نوح إنه كان عبدا شكورا )</quran_verse> [ الإسراء : 3 ]</cross_references> <etymology>فإسرائيل هو يعقوب عليه السلام ،</etymology>
</tafsir_chunk>
1209|<tafsir_chunk>
        بدليل ما رواه <source/>أبو داود الطيالسي : <isnad>حدثنا عبد الحميد بن بهرام ، عن شهر بن حوشب ، قال : حدثني عبد الله بن عباس قال :</isnad>
</tafsir_chunk>
1210|<tafsir_chunk>
<hadith>حضرت عصابة من اليهود نبي الله صلى الله عليه وسلم ، فقال لهم : هل تعلمون أن إسرائيل يعقوب ؟ . قالوا : اللهم نعم . فقال النبي صلى الله عليه وسلم : اللهم اشهد</hadith>
</tafsir_chunk>
1211|<tafsir_chunk>
      وقال <source/>الأعمش ، <isnad>عن إسماعيل بن رجاء ، عن عمير مولى ابن عباس ، عن عبد الله بن عباس</isnad> <etymology>أن إسرائيل كقولك : عبد الله .</etymology>
</tafsir_chunk>
1212|<tafsir_chunk>
      وقوله تعالى : <quran_verse>( اذكروا نعمتي التي أنعمت عليكم )</quran_verse>
</tafsir_chunk>
1213|<tafsir_chunk>
<opinions_of_scholars>قال مجاهد : نعمة الله التي أنعم بها عليهم فيما سمى وفيما سوى ذلك ، فجر لهم الحجر ، وأنزل عليهم المن والسلوى ، وأنجاهم من عبودية آل فرعون .</opinions_of_scholars>
</tafsir_chunk>
1214|<tafsir_chunk>
<opinions_of_scholars>وقال أبو العالية : نعمته أن جعل منهم الأنبياء والرسل ، وأنزل عليهم الكتب .</opinions_of_scholars>
</tafsir_chunk>
1215|<tafsir_chunk>
<methodological_notes>قلت : وهذا كقول موسى عليه السلام لهم :</methodological_notes> <cross_references><quran_verse>( يا قوم اذكروا نعمة الله عليكم إذ جعل فيكم أنبياء وجعلكم ملوكا وآتاكم ما لم يؤت أحدا من العالمين )</quran_verse> [ المائدة : 20 ]</cross_references> يعني في زمانهم .
    </tafsir_chunk>
1216|<tafsir_chunk>
      وقال <source/>محمد بن إسحاق : <isnad>حدثني محمد بن أبي محمد ، عن عكرمة أو سعيد بن جبير ، عن ابن عباس ،</isnad> في قوله : <quran_verse>( اذكروا نعمتي التي أنعمت عليكم )</quran_verse>
</tafsir_chunk>
1217|<tafsir_chunk>
<opinions_of_scholars>أي : بلائي عندكم وعند آبائكم لما كان نجاهم به من فرعون وقومه</opinions_of_scholars>
</tafsir_chunk>
1218|<tafsir_chunk>
<quran_verse>( وأوفوا بعهدي أوف بعهدكم )</quran_verse> <opinions_of_scholars>قال : بعهدي الذي أخذت في أعناقكم للنبي صلى الله عليه وسلم إذا جاءكم .</opinions_of_scholars>
</tafsir_chunk>
1219|<tafsir_chunk>
<quran_verse>( أوف بعهدكم )</quran_verse> <opinions_of_scholars>أي : أنجز لكم ما وعدتكم عليه بتصديقه واتباعه ، بوضع ما كان عليكم من الإصر والأغلال التي كانت في أعناقكم بذنوبكم التي كانت من إحداثكم .</opinions_of_scholars>
</tafsir_chunk>
1220|<tafsir_chunk>
        [ <opinions_of_scholars>وقال الحسن البصري : هو قوله : <cross_references><quran_verse>( ولقد أخذ الله ميثاق بني إسرائيل وبعثنا منهم اثني عشر نقيبا وقال الله إني معكم لئن أقمتم الصلاة وآتيتم الزكاة وآمنتم برسلي وعزرتموهم وأقرضتم الله قرضا حسنا لأكفرن عنكم سيئاتكم ولأدخلنكم جنات تجري من تحتها الأنهار )</quran_verse> الآية [ المائدة : 12 ] .</cross_references></opinions_of_scholars>
</tafsir_chunk>
1221|<tafsir_chunk>
<opinions_of_scholars>وقال آخرون : هو الذي أخذه الله عليهم في التوراة أنه سيبعث من بني إسماعيل نبيا عظيما يطيعه جميع الشعوب ، والمراد به محمد صلى الله عليه وسلم فمن اتبعه غفر له ذنبه وأدخل الجنة وجعل له أجران .</opinions_of_scholars>
</tafsir_chunk>
1222|<tafsir_chunk>
        وقد أورد <source/>فخر الدين الرازي هاهنا <theological_points>بشارات كثيرة عن الأنبياء عليهم السلام بمحمد صلى الله عليه وسلم</theological_points> ] .
      </tafsir_chunk>
1223|<tafsir_chunk>
      وقال أبو العالية : <quran_verse>( وأوفوا بعهدي )</quran_verse> <opinions_of_scholars>قال : عهده إلى عباده : دينه الإسلام أن يتبعوه .</opinions_of_scholars>
</tafsir_chunk>
1224|<tafsir_chunk>
      وقال الضحاك ، عن ابن عباس : <quran_verse>( أوف بعهدكم )</quran_verse> <opinions_of_scholars>قال : أرض عنكم وأدخلكم الجنة .</opinions_of_scholars>
</tafsir_chunk>
1225|<tafsir_chunk>
<opinions_of_scholars>وكذا قال السدي ، والضحاك ، وأبو العالية ، والربيع بن أنس .</opinions_of_scholars>
</tafsir_chunk>
1226|<tafsir_chunk>
      وقوله : <quran_verse>( وإياي فارهبون )</quran_verse> <linguistic_analysis>أي : فاخشون ؛</linguistic_analysis> <opinions_of_scholars>قاله أبو العالية ، والسدي ، والربيع بن أنس ، وقتادة .</opinions_of_scholars>
</tafsir_chunk>
1227|<tafsir_chunk>
      وقال ابن عباس في قوله تعالى : <quran_verse>( وإياي فارهبون )</quran_verse> <opinions_of_scholars>أي أنزل بكم ما أنزل بمن كان قبلكم من آبائكم من النقمات التي قد عرفتم من المسخ وغيره .</opinions_of_scholars>
</tafsir_chunk>
1228|<tafsir_chunk>
<balagha_analysis>وهذا انتقال من الترغيب إلى الترهيب ، فدعاهم إليه بالرغبة والرهبة ،</balagha_analysis> <daawah_applications>لعلهم يرجعون إلى الحق واتباع الرسول والاتعاظ بالقرآن وزواجره ، وامتثال أوامره ، وتصديق أخباره ،</daawah_applications>
</tafsir_chunk>
1229|<tafsir_chunk>
      والله الهادي لمن يشاء إلى صراطه المستقيم
    </tafsir_chunk>
1230|<tafsir_chunk>
      ولهذا قال : <quran_verse>( وآمنوا بما أنزلت مصدقا لما معكم )</quran_verse> [ <grammatical_parsing>( مصدقا ) ماضيا منصوبا على الحال من ( بما ) أي : بالذي أنزلت مصدقا أو من الضمير المحذوف من قولهم : بما أنزلته مصدقا ، ويجوز أن يكون مصدرا من غير الفعل وهو قوله : ( بما أنزلت مصدقا )</grammatical_parsing> ]
    </tafsir_chunk>
1231|<tafsir_chunk>
<opinions_of_scholars>يعني به : القرآن الذي أنزله على محمد النبي الأمي العربي بشيرا ونذيرا وسراجا منيرا مشتملا على الحق من الله تعالى ، مصدقا لما بين يديه من التوراة والإنجيل .</opinions_of_scholars>
</tafsir_chunk>
1232|<tafsir_chunk>
      قال أبو العالية ، رحمه الله ، في قوله : <quran_verse>( وآمنوا بما أنزلت مصدقا لما معكم )</quran_verse> <opinions_of_scholars>يقول : يا معشر أهل الكتاب آمنوا بما أنزلت مصدقا لما معكم يقول : لأنهم يجدون محمدا صلى الله عليه وسلم مكتوبا عندهم في التوراة والإنجيل .</opinions_of_scholars>
</tafsir_chunk>
1233|<tafsir_chunk>
<opinions_of_scholars>وروي عن مجاهد والربيع بن أنس وقتادة نحو ذلك .</opinions_of_scholars>
</tafsir_chunk>
1234|<tafsir_chunk>
      وقوله : <quran_verse>( ولا تكونوا أول كافر به )</quran_verse> [ <opinions_of_scholars>قال بعض المفسرين : أول فريق كافر به ونحو ذلك</opinions_of_scholars> ] .
    </tafsir_chunk>
1235|<tafsir_chunk>
      قال ابن عباس : <quran_verse>( ولا تكونوا أول كافر به )</quran_verse> <opinions_of_scholars>وعندكم فيه من العلم ما ليس عند غيركم .</opinions_of_scholars>
</tafsir_chunk>
1236|<tafsir_chunk>
      وقال أبو العالية : يقول : <quran_verse>( ولا تكونوا أول [ كافر به )</quran_verse> أول ] <opinions_of_scholars>من كفر بمحمد صلى الله عليه وسلم [ يعني من جنسكم أهل الكتاب بعد سماعهم بمحمد وبمبعثه ] .</opinions_of_scholars>
</tafsir_chunk>
1237|<tafsir_chunk>
<opinions_of_scholars>وكذا قال الحسن ، والسدي ، والربيع بن أنس .</opinions_of_scholars>
</tafsir_chunk>
1238|<tafsir_chunk>
<opinions_of_scholars>واختار <source/>ابن جرير أن الضمير في قوله : ( به ) عائد على القرآن ، الذي تقدم ذكره في قوله : ( بما أنزلت ) وكلا القولين صحيح ؛ <argument>لأنهما متلازمان ، لأن من كفر بالقرآن فقد كفر بمحمد صلى الله عليه وسلم ، ومن كفر بمحمد صلى الله عليه وسلم فقد كفر بالقرآن .</argument></opinions_of_scholars>
</tafsir_chunk>
1239|<tafsir_chunk>
<contextual_scope>وأما قوله : ( أول كافر به ) فيعني به أول من كفر به من بني إسرائيل ؛ لأنه قد تقدمهم من كفار قريش وغيرهم من العرب بشر كثير ، وإنما المراد أول من كفر به من بني إسرائيل مباشرة ، فإن يهود المدينة أول بني إسرائيل خوطبوا بالقرآن ، فكفرهم به يستلزم أنهم أول من كفر به من جنسهم .</contextual_scope>
</tafsir_chunk>
1240|<tafsir_chunk>
      وقوله : <quran_verse>( ولا تشتروا بآياتي ثمنا قليلا )</quran_verse> يقول : <opinions_of_scholars>لا تعتاضوا عن الإيمان بآياتي وتصديق رسولي بالدنيا وشهواتها ، فإنها قليلة فانية ،</opinions_of_scholars>
</tafsir_chunk>
1241|<tafsir_chunk>
      كما قال <source/>عبد الله بن المبارك : <isnad>أنبأنا عبد الرحمن بن يزيد بن جابر ، عن هارون بن زيد قال : سئل الحسن ، يعني البصري ، عن قوله تعالى : ( ثمنا قليلا ) قال :</isnad> <opinions_of_scholars>الثمن القليل الدنيا بحذافيرها .</opinions_of_scholars>
</tafsir_chunk>
1242|<tafsir_chunk>
      وقال <source/>ابن لهيعة : <isnad>حدثني عطاء بن دينار ، عن سعيد بن جبير ،</isnad> في قوله : <quran_verse>( ولا تشتروا بآياتي ثمنا قليلا )</quran_verse> <opinions_of_scholars>وإن آياته : كتابه الذي أنزله إليهم ، وإن الثمن القليل : الدنيا وشهواتها .</opinions_of_scholars>
</tafsir_chunk>
1243|<tafsir_chunk>
      وقال السدي : <quran_verse>( ولا تشتروا بآياتي ثمنا قليلا )</quran_verse> <opinions_of_scholars>يقول : لا تأخذوا طمعا قليلا ولا تكتموا اسم الله لذلك الطمع وهو الثمن .</opinions_of_scholars>
</tafsir_chunk>
1244|<tafsir_chunk>
      وقال أبو جعفر ، <isnad>عن الربيع بن أنس ، عن أبي العالية</isnad> في قوله تعالى : <quran_verse>( ولا تشتروا بآياتي ثمنا قليلا )</quran_verse> <opinions_of_scholars>يقول : لا تأخذوا عليه أجرا . قال : وهو مكتوب عندهم في الكتاب الأول : يا ابن آدم علم مجانا كما علمت مجانا .</opinions_of_scholars>
</tafsir_chunk>
1245|<tafsir_chunk>
      وقيل : <variant_interpretations>معناه لا تعتاضوا عن البيان والإيضاح ونشر العلم النافع في الناس بالكتمان واللبس لتستمروا على رياستكم في الدنيا القليلة الحقيرة الزائلة عن قريب ،</variant_interpretations>
</tafsir_chunk>
1246|<tafsir_chunk>
        وفي <source/>سنن أبي داود <isnad>عن أبي هريرة قال : قال رسول الله صلى الله عليه وسلم :</isnad> <hadith>من تعلم علما مما يبتغى به وجه الله لا يتعلمه إلا ليصيب به عرضا من الدنيا لم يرح رائحة الجنة يوم القيامة</hadith>
</tafsir_chunk>
1247|<tafsir_chunk>
        وأما تعليم العلم بأجرة ، فإن كان قد تعين عليه فلا يجوز أن يأخذ عليه أجرة ، ويجوز أن يتناول من بيت المال ما يقوم به حاله وعياله ، فإن لم يحصل له منه شيء وقطعه التعليم عن التكسب ، فهو كما لم يتعين عليه ، وإذا لم يتعين عليه ، فإنه يجوز أن يأخذ عليه أجرة عند <source/>مالك و<source/>الشافعي و<source/>أحمد وجمهور العلماء ،
      </tafsir_chunk>
1248|<tafsir_chunk>
          كما في <source/>صحيح البخاري عن أبي سعيد في قصة اللديغ : <hadith>إن أحق ما أخذتم عليه أجرا كتاب الله</hadith>
</tafsir_chunk>
1249|<tafsir_chunk>
          وقوله في قصة المخطوبة : <hadith>زوجتكها بما معك من القرآن</hadith>
</tafsir_chunk>
1250|<tafsir_chunk>
        فأما حديث <source/>عبادة بن الصامت ، <hadith>أنه علم رجلا من أهل الصفة شيئا من القرآن فأهدى له قوسا ، فسأل عنه رسول الله صلى الله عليه وسلم فقال : إن أحببت أن تطوق بقوس من نار فاقبله فتركه</hadith> ، رواه <source/>أبو داود وروي مثله عن أبي بن كعب مرفوعا ، <chain_evaluation>فإن صح إسناده</chain_evaluation> فهو محمول عند كثير من العلماء منهم : <source/>أبو عمر بن عبد البر على أنه لما علمه الله لم يجز بعد هذا أن يعتاض عن ثواب الله بذلك القوس ، فأما إذا كان من أول الأمر على التعليم بالأجرة فإنه يصح كما في حديث اللديغ وحديث سهل في المخطوبة ، والله أعلم .
      </tafsir_chunk>
1251|<tafsir_chunk>
<quran_verse>( وإياي فاتقون )</quran_verse> قال <source/>ابن أبي حاتم : <isnad>حدثنا أبو عمر الدوري ، حدثنا أبو إسماعيل المؤدب ، عن عاصم الأحول ، عن أبي العالية ، عن طلق بن حبيب ، قال :</isnad> <technical_definitions>التقوى أن تعمل بطاعة الله رجاء رحمة الله على نور من الله ، والتقوى أن تترك معصية الله مخافة عذاب الله على نور من الله .</technical_definitions>
</tafsir_chunk>
1252|<tafsir_chunk>
      ومعنى قوله : <quran_verse>( وإياي فاتقون )</quran_verse> <opinions_of_scholars>أنه تعالى يتوعدهم فيما يتعمدونه من كتمان الحق وإظهار خلافه ومخالفتهم الرسول ، صلوات الله وسلامه عليه .</opinions_of_scholars>
</tafsir_chunk>
1253|<tafsir_chunk>
<command_and_prohibition>يقول تعالى ناهيا لليهود عما كانوا يتعمدونه ، من تلبيس الحق بالباطل ، وتمويهه به وكتمانهم الحق وإظهارهم الباطل :</command_and_prohibition> <quran_verse>( ولا تلبسوا الحق بالباطل وتكتموا الحق وأنتم تعلمون )</quran_verse> <command_and_prohibition>فنهاهم عن الشيئين معا ، وأمرهم بإظهار الحق والتصريح به ؛</command_and_prohibition>
</tafsir_chunk>
1254|<tafsir_chunk>
      ولهذا قال الضحاك ، عن ابن عباس <quran_verse>( ولا تلبسوا الحق بالباطل )</quran_verse> <opinions_of_scholars>لا تخلطوا الحق بالباطل والصدق بالكذب .</opinions_of_scholars>
</tafsir_chunk>
1255|<tafsir_chunk>
      وقال أبو العالية : <quran_verse>( ولا تلبسوا الحق بالباطل )</quran_verse> <opinions_of_scholars>يقول : ولا تخلطوا الحق بالباطل ، وأدوا النصيحة لعباد الله من أمة محمد صلى الله عليه وسلم .</opinions_of_scholars>
</tafsir_chunk>
1256|<tafsir_chunk>
<opinions_of_scholars>ويروى عن سعيد بن جبير والربيع بن أنس ، نحوه .</opinions_of_scholars>
</tafsir_chunk>
1257|<tafsir_chunk>
      وقال قتادة : <quran_verse>( ولا تلبسوا الحق بالباطل )</quran_verse> <opinions_of_scholars>[ قال ] ولا تلبسوا اليهودية والنصرانية بالإسلام ؛ إن دين الله الإسلام ، واليهودية والنصرانية بدعة ليست من الله .</opinions_of_scholars>
</tafsir_chunk>
1258|<tafsir_chunk>
<opinions_of_scholars>وروي عن الحسن البصري نحو ذلك .</opinions_of_scholars>
</tafsir_chunk>
1259|<tafsir_chunk>
      وقال <source/>محمد بن إسحاق : <isnad>حدثني محمد بن أبي محمد ، عن عكرمة أو سعيد بن جبير ، عن ابن عباس :</isnad> <quran_verse>( وتكتموا الحق وأنتم تعلمون )</quran_verse>
</tafsir_chunk>
1260|<tafsir_chunk>
