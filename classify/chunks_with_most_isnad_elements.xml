|<tafsir_chunk>
<linguistic_analysis>وضمن " تكلم " تدعو ; لأن كلامه الناس في كهولته ليس بأمر عجيب .</linguistic_analysis>
</tafsir_chunk>
|<tafsir_chunk>
<opinions_of_scholars>وقوله :</opinions_of_scholars>
</tafsir_chunk>
|<tafsir_chunk>
