2229|<tafsir_chunk>
<opinions_of_scholars>وقال <source/>مجاهد عن أصحاب <source/>ابن مسعود : ( <quran_verse>أو ننسئها</quran_verse> ) <nasikh_wa_mansukh>نثبت خطها ونبدل حكمها</nasikh_wa_mansukh> .</opinions_of_scholars>
</tafsir_chunk>
2230|<tafsir_chunk>
<opinions_of_scholars>وقال <source/>عبيد بن عمير ، و <source/>مجاهد ، و <source/>عطاء : ( <quran_verse>أو ننسئها</quran_verse> ) <linguistic_analysis>نؤخرها ونرجئها</linguistic_analysis> .</opinions_of_scholars>
</tafsir_chunk>
2231|<tafsir_chunk>
<opinions_of_scholars>وقال <source/>عطية العوفي : ( <quran_verse>أو ننسئها</quran_verse> ) <linguistic_analysis>نؤخرها فلا ننسخها</linguistic_analysis> .</opinions_of_scholars>
</tafsir_chunk>
2232|<tafsir_chunk>
<opinions_of_scholars>وقال <source/>السدي مثله أيضا ، وكذا [ قال ] <source/>الربيع بن أنس .</opinions_of_scholars>
</tafsir_chunk>
2233|<tafsir_chunk>
<opinions_of_scholars>وقال <source/>الضحاك : ( <quran_verse>ما ننسخ من آية أو ننسئها</quran_verse> ) يعني : <nasikh_wa_mansukh>الناسخ من المنسوخ</nasikh_wa_mansukh> .</opinions_of_scholars>
