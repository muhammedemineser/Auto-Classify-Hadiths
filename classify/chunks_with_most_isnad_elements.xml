|<tafsir_chunk>
<cross_references>كما قال : ( <quran_verse>قل متاع الدنيا قليل والآخرة خير لمن اتقى ولا تظلمون فتيلا</quran_verse> ) [ النساء : 77 ]</cross_references>
</tafsir_chunk>
