|<tafsir_chunk>
<opinions_of_scholars>
        وقال : <cross_references><quran_verse>( نبئ عبادي أني أنا الغفور الرحيم وأن عذابي هو العذاب الأليم )</quran_verse> <source/>[ الحجر : 49 ، 50 ]</cross_references>
</opinions_of_scholars>
</tafsir_chunk>
|<tafsir_chunk>
<opinions_of_scholars>
        إلى أمثال ذلك من الآيات التي تجمع <spiritual_lessons>الرجاء والخوف</spiritual_lessons> .
