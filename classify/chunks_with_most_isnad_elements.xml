|<tafsir_chunk>، <cross_references>وقوله : <quran_verse>( إن الذين يخشون ربهم بالغيب لهم مغفرة وأجر كبير )</quran_verse> [ الملك : 12 ]</cross_references></tafsir_chunk>
|<tafsir_chunk>، <quran_verse>( وهم من الساعة مشفقون )</quran_verse> <linguistic_analysis>أي : خائفون وجلون</linguistic_analysis> .</tafsir_chunk>
