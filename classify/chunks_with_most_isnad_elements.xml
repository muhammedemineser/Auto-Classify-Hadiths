|<tafsir_chunk>
<asbab_al_nuzul>فأنزل الله : <quran_verse>( وما أرسلنا من قبلك من رسول [ ولا نبي إلا إذا تمنى ] )</quran_verse> الآية ، فدحر الله الشيطان .</asbab_al_nuzul>
