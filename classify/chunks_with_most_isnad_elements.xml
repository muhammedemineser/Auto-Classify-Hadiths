<cross_references>
        ، كما قال تعالى : <quran_verse>( أولم يروا أن الله الذي خلق السماوات والأرض ولم يعي بخلقهن بقادر على أن يحيي الموتى بلى إنه على كل شيء قدير )</quran_verse>
</cross_references>
</tafsir_chunk>
