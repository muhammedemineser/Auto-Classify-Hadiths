|<tafsir_chunk> ( <quran_verse>وذلك الفوز المبين</quran_verse> ) <cross_references>كما قال : ( <quran_verse>فمن زحزح عن النار وأدخل الجنة فقد فاز</quran_verse> ) [ <source/>آل عمران : 185 ]</cross_references></tafsir_chunk>
