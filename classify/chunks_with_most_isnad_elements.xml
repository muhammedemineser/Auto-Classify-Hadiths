6724|<tafsir_chunk>
<cross_references>كقوله تعالى : <quran_verse>( أيحسبون أنما نمدهم به من مال وبنين نسارع لهم في الخيرات بل لا يشعرون )</quran_verse> [ المؤمنون : 55 ، 56 ]</cross_references>
</tafsir_chunk>
6725|<tafsir_chunk>
<cross_references> ، وكقوله <quran_verse>( فذرني ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون )</quran_verse> [ القلم : 44 ]</cross_references>
</tafsir_chunk>
6726|<tafsir_chunk>
<cross_references> ، وكقوله <quran_verse>( فلا تعجبك أموالهم ولا أولادهم إنما يريد الله ليعذبهم بها في الحياة الدنيا وتزهق أنفسهم وهم كافرون )</quran_verse> [ التوبة : 55 ] .</cross_references>
</tafsir_chunk>
6727|<tafsir_chunk>
      ثم قال تعالى : <quran_verse>( ما كان الله ليذر المؤمنين على ما أنتم عليه حتى يميز الخبيث من الطيب )</quran_verse>
