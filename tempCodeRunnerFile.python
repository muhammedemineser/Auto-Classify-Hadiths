from collections import defaultdict

cand_txt = [
    "the prophet said",
    "in the name of god",
    "the prophet said",
    "pray five times",
    "in the name of god",
    "the prophet said",
    "give to the poor",
]

index_map = defaultdict(list)
for i, line in enumerate(cand_txt):
    index_map[line].append(i)
duplicates = {line: indices for line, indices in index_map.items() if len(indices) > 1}
print(duplicates)